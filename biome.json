{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!node_modules",
      "!!target",
      "!!dist",
      "!!.venv-tags",
      "!!**/__pycache__",
      "!!src-tauri/gen",
      "!!src-tauri/resources/audio-tools",
      "!!src-tauri/resources/audio-tools.staging",
      "!!src-tauri/resources/linux",
      "!!vendor",
      "!!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "assist": {
    "actions": { "source": { "organizeImports": "on" } }
  }
}
